# Groq API Keys Configuration (All formats supported and auto-detected):
# Option 1: Comma-separated list of keys
GROQ_API_KEYS=gsk_key1_...,gsk_key2_...,gsk_key3_...,gsk_key4_...,gsk_key5_...

# Option 2: Individual numbered keys
# GROQ_API_KEY_1=gsk_key1_...
# GROQ_API_KEY_2=gsk_key2_...
# GROQ_API_KEY_3=gsk_key3_...
# GROQ_API_KEY_4=gsk_key4_...
# GROQ_API_KEY_5=gsk_key5_...

# Option 3: Primary + Backup keys
# GROQ_API_KEY=gsk_primary_key_...
# BACKUP_GROQ_API_KEYS=gsk_backup_key1_...,gsk_backup_key2_...

